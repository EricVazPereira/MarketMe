# Copie para .env e ajuste conforme o ambiente
DATABASE_URL=postgres://pointer:sysadmin@localhost:5432/marketme
PORT=3000

# Chave Pix do recebedor (usada no payload copia-e-cola gerado por pedido)
PIX_KEY=marketme@example.com
PIX_MERCHANT_NAME=MARKETME
PIX_MERCHANT_CITY=SAO PAULO

# Segredo compartilhado com o PSP para autenticar o webhook de pagamento
PSP_WEBHOOK_SECRET=troque-este-segredo

# Autenticação básica das APIs (opcional). Se definidos, todas as rotas
# exigem usuário/senha (exceto /health e /webhooks/psp). Configure os
# mesmos valores na tela de configurações do app.
#API_USER=marketme
#API_PASS=troque-esta-senha
