# Copie para .env e ajuste conforme o ambiente.

# ─── Firebird do ERP (acesso direto nesta fase) ─────────────────────────
# Caminho do banco no PC onde o Firebird roda. O app também pode enviar
# o caminho pela tela de configurações (campo "diretório do banco").
FIREBIRD_DATABASE=D:\marketme\bd\orestra.fdb
FIREBIRD_HOST=127.0.0.1
FIREBIRD_PORT=3050
FIREBIRD_USER=POINTER
FIREBIRD_PASSWORD=sysadmin

# Nomes de tabelas/campos do ERP — ajuste se no seu banco forem outros
#FB_EMPRESA_TABLE=EMPRESA
#FB_EMPRESA_ID=CODIGO
#FB_EMPRESA_FANTASIA=NOME_FANTASIA
#FB_PRODUTO_TABLE=PRODUTO
#FB_PRODUTO_CODIGO=CODIGO
#FB_PRODUTO_EAN=CODIGO_BARRA
#FB_PRODUTO_NOME=DESCRICAO
#FB_PRODUTO_PRECO=PRECO_VENDA

# ─── PostgreSQL local do conector (pedidos e pagamentos do MarketMe) ────
# Rode "npm run db:setup" para criar usuário/banco e gerar esta linha.
DATABASE_URL=postgres://usuario:senha@localhost:5432/marketme
PORT=3000

# ─── Pix ────────────────────────────────────────────────────────────────
PIX_KEY=marketme@example.com
PIX_MERCHANT_NAME=MARKETME
PIX_MERCHANT_CITY=SAO PAULO
PSP_WEBHOOK_SECRET=troque-este-segredo

# ─── Autenticação básica das APIs (opcional) ────────────────────────────
# Se definidos, todas as rotas exigem usuário/senha (exceto /health e
# /webhooks/psp). Preencha o token/senha da API no app com estes valores.
#API_USER=marketme
#API_PASS=troque-esta-senha
