<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="br.com.marketme.app"
    android:versionCode="15"
    android:versionName="0.4.9">

    <!-- targetSdk 35 (Android 15): evita o aviso de "app feito para versão
         antiga / sem proteções de privacidade" na instalação. O app cumpre
         as exigências: permissão de câmera em runtime, exported explícito,
         assinatura v2/v3 e insets tratados (edge-to-edge do Android 15 —
         ver fitsSystemWindows no MainActivity). Não subir para 36 enquanto
         o build usar aapt/android.jar antigos: o alvo 36 liga o predictive
         back por padrão e desativar exige um atributo de manifesto que o
         aapt 29 não conhece. -->
    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="35"/>

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <application
        android:label="MarketMe"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
